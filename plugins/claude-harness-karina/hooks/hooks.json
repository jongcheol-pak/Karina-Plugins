{
  "description": "karina harness hooks — 이벤트·matcher 마다 PowerShell 하나: 스크립트가 둘 이상이면 scripts/hook-dispatch.ps1 이 한 프로세스에서 차례로 부르고, 하나면 직접 실행한다(자식 셸 재기동 없음 — v1.108.0. 실행 셸은 Claude Code의 powershell 해석을 따름: 실측 pwsh 우선·NoProfile, 스크립트는 5.1 호환 유지); cross-platform; Windows verified, macOS/Linux experimental",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" -Blocking block-destructive.ps1 guard-bash.ps1; exit $LASTEXITCODE",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" -Blocking guard-write.ps1 guard-harness.ps1; exit $LASTEXITCODE",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" loop-continue.ps1 record-work-start.ps1 inject-reply-language.ps1; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" suggest-agents-record.ps1 inject-reply-language.ps1; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" post-write-checks.ps1 inject-reply-language.ps1; exit $LASTEXITCODE",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" warn-version-drift.ps1 session-context.ps1; exit $LASTEXITCODE",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "compact|fork",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-cleanup.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(karina:)?plan$",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-dispatch.ps1\" loop-continue.ps1 record-work-start.ps1; exit $LASTEXITCODE",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "^(karina:)?implement$",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/loop-continue.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(karina:)?chain-plan$",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/record-work-start.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/loop-continue.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
